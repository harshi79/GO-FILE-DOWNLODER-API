# Telegram Bot API token from @BotFather (required)
BOT_TOKEN=123456789:REPLACE-ME-with-the-token-from-BotFather

# Optional: your own GoFile account token (https://gofile.io/myprofile).
# If set, it is used instead of creating a throwaway guest account. A Premium
# token also lifts GoFile's guest rate limits and works with the documented
# API. Leave empty to let the bot create a free guest account automatically.
GOFILE_API_TOKEN=

# Optional: salt used for GoFile's client-side website token. The default is
# the value currently embedded in GoFile's public web client. Only change this
# if GoFile rotates it and you know the new value.
GOFILE_WT_SALT=12af056dacea0b

# Optional: allow arbitrary direct http(s) file links (default true).
# Direct links are SSRF-guarded (only public IPs are ever contacted).
# Set to false to accept only the known file hosts (GoFile, Google Drive,
# Dropbox, OneDrive, MediaFire, Pixeldrain, archive.org).
# ENABLE_DIRECT_DOWNLOADS=true

# Optional: port for the HTTP /health server (default 10000).
# Hosting platforms like Render set PORT automatically.
# PORT=10000
