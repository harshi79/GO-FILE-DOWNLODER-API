# Telegram Bot API token from @BotFather (required)
BOT_TOKEN=123456789:REPLACE-ME-with-the-token-from-BotFather

# Optional: your own GoFile account token (https://gofile.io/myprofile).
# If set, it is used instead of creating a throwaway guest account. A Premium
# token also lifts GoFile's guest rate limits and works with the documented
# API. Leave empty to let the bot create a free guest account automatically.
GOFILE_API_TOKEN=

# Optional: salt used for GoFile's client-side website token. The default is
# the value currently embedded in GoFile's public web client. Only change this
# if GoFile rotates it and you know the new value.
GOFILE_WT_SALT=12af056dacea0b

# Optional: allow arbitrary direct http(s) file links (default true).
# Direct links are SSRF-guarded (only public IPs are ever contacted).
# Set to false to accept only the known file hosts (GoFile, Google Drive,
# Dropbox, OneDrive, MediaFire, Pixeldrain, archive.org).
# ENABLE_DIRECT_DOWNLOADS=true

# Optional: port for the HTTP /health server (default 10000).
# Hosting platforms like Render set PORT automatically.
# PORT=10000

# Recommended big-file mode: send documents up to ~2 GB via MTProto in this
# same process. Obtain your app credentials privately at my.telegram.org/apps.
# Uses BOT_TOKEN above; no phone number or user session string is needed.
ENABLE_MTPROTO=false
API_ID=
API_HASH=

# Alternative big-file mode: a separate Local Telegram Bot API server with
# --local. Leave ENABLE_MTPROTO=false for this alternative; don't enable both.
# See README for logOut migration, shared volume and permission requirements.
# TELEGRAM_API_URL=http://telegram-bot-api:8081
# DOWNLOAD_DIR=/downloads

# In MTProto/cloud mode, DOWNLOAD_DIR is optional (default: system temp dir).
# It must be DISK-backed (not tmpfs/RAM) with ~3 GB free for a near-2 GB file.
# Docker defaults DOWNLOAD_DIR to /app/downloads on its normal filesystem.
# The policy cap is 2,000,000,000 bytes. ZIP input + total expanded output
# are each capped at 20,000,000 bytes. Limits cannot be raised via environment.
# One active transfer, at most 8 accepted jobs; extra users get a busy response.

# Optional: operator panel (/admin, /ban, /unban).
# Comma-separated numeric Telegram ids. Get yours from @userinfobot.
# Leave empty to disable the panel entirely.
# ADMIN_USER_IDS=123456789,987654321

# Optional: where usage counters are stored (SQLite, stdlib only).
# Defaults to $DATA_DIR/usage.sqlite3, or ./data/usage.sqlite3.
# Mount this directory as a persistent volume to keep /admin stats
# across redeploys. Set USAGE_DB=:memory: to disable persistence.
# USAGE_DB=/app/data/usage.sqlite3
